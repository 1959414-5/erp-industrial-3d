# Configuração da conexão com o MySQL.
# Copie este arquivo para ".env" e ajuste a senha.
#   (no Windows PowerShell:  Copy-Item .env.example .env )

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TROQUE_PELA_SUA_SENHA
DB_NAME=erp_industrial_analytics
# Banco em nuvem (TiDB Cloud etc.) exige conexão criptografada: DB_SSL=true  (local: deixe em branco)
DB_SSL=

# Porta em que a API vai rodar
PORT=3001

# ── Assistente de IA (opcional) ─────────────────────────────────────────
# Sem nenhuma chave, o painel usa o motor de análise local (offline) automaticamente.
# Escolha UM provedor em AI_PROVIDER (os demais configurados viram reserva automática):
#   groq      → GRÁTIS, sem cartão. gpt-oss-120b (Llama saiu do plano gratuito). Chave em https://console.groq.com/keys
#   gemini    → GRÁTIS, sem cartão. Chave em https://aistudio.google.com/apikey
#   anthropic → Claude (pago; precisa de crédito em console.anthropic.com)
#   ollama    → GRÁTIS e 100% local no seu PC (instale https://ollama.com e rode: ollama pull llama3.1)
# NUNCA commite o .env.
AI_PROVIDER=groq

GROQ_API_KEY=
# (o plano gratuito da Groq trocou de modelos; se este sumir, a API descobre outro sozinha)
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (local): defina o modelo para ativar, ex.: OLLAMA_MODEL=llama3.1
OLLAMA_MODEL=

# Limites de proteção
AI_RATE_LIMIT=20
# Teto diário de perguntas (0 = sem teto)
AI_DAILY_LIMIT=300
# Em produção, restrinja quem pode chamar a API (separe por vírgula):
# CORS_ORIGIN=https://SEU-USUARIO.github.io

# Painel de produção: uma máquina conta como "operando" se apontou produção até N horas antes do apontamento mais recente da base
MACHINE_ACTIVE_HOURS=24
